# Copy this file to .env and set credentials from the Binance Web3 API portal.
BINANCE_WEB3_API_KEY=
BINANCE_WEB3_API_SECRET=

# Local development only. Keep the gateway bound to loopback.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8787
GATEWAY_PER_IP_RPM=90
GATEWAY_GLOBAL_RPM=600

# Set the exact Chrome Web Store extension ID for a store release.
# Public ZIP previews use a public client token and must be rate-limited.
GATEWAY_EXTENSION_ID=

# Add the public website origin when deploying behind tradetag.site.
GATEWAY_ALLOWED_ORIGINS=https://tradetag.site,https://www.tradetag.site

# Required for a non-loopback deployment. If bundled in a public preview, treat it
# as a public client token, not a secret. Never put Binance API credentials here.
GATEWAY_BEARER_TOKEN=
